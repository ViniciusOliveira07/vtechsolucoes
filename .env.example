# Evolution API (EVO): avisa o grupo do WhatsApp a cada lead do site.
# Mesmos valores da tela de Configurações da plataforma de prospecção.
# Preencha na hospedagem (variáveis de ambiente) e, para testar localmente, num arquivo .env.local.
# Nunca coloque estes valores no código.
EVO_URL=
EVO_INSTANCE=
EVO_API_KEY=
EVO_GROUP_JID=
# Opcionais: header extra exigido pelo proxy na frente da Evolution (se a plataforma usa um)
EVO_HEADER_NAME=
EVO_HEADER_VALUE=
